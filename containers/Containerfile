# Linux x86-64 CPU build, pinned base inspected 2026-09-17.
FROM docker.io/library/python:3.11.13-slim-bookworm@sha256:cec9aa7aa96eea4fa036e9b82be1e6b325f2e3707f462d885868df51ec0a4b47
ARG ENVIRONMENT=core
COPY containers/${ENVIRONMENT}.lock.txt /opt/requirements.lock.txt
RUN pip install --no-cache-dir --require-hashes -r /opt/requirements.lock.txt
COPY dist/rewirebench-*.whl /tmp/wheels/
RUN pip install --no-cache-dir --no-deps /tmp/wheels/*.whl && rm -rf /tmp/wheels
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
WORKDIR /work
ENTRYPOINT ["rewirebench"]
CMD ["protocols"]
