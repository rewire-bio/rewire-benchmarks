manifest {
    name = 'rewire-benchmarks/evaluation-matrix'
    nextflowVersion = '!24.10.5'
}
params {
    jobs = null
    outdir = null
    environment_id = null
    container_image = null
    execution_profile = 'native'
    max_concurrent = 2
    google_project = null
    google_region = null
    google_service_account = null
    google_work_dir = null
    google_install_gpu_drivers = false
    slurm_partition = null
    slurm_account = null
    gpu_devices = null
}
process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    time = '1h'
    maxForks = params.max_concurrent
    errorStrategy = { task.exitStatus in [137, 143] && task.attempt < 2 ? 'retry' : 'terminate' }
    maxRetries = 1
    shell = ['/bin/bash', '-euo', 'pipefail']
}
executor.queueSize = params.max_concurrent
// Local work artifacts contain labels and predictions. Never publish this directory publicly.
trace.enabled = true
trace.overwrite = true
trace.file = "${params.outdir}/trace.tsv"
trace.fields = 'task_id,hash,name,status,exit,attempt,cpus,memory,duration,realtime,peak_rss'
profiles {
    'native' {
        params.execution_profile = 'native'
    }
    podman {
        params.execution_profile = 'podman'
        podman.enabled = true
        process.container = params.container_image
    }
    apptainer {
        params.execution_profile = 'apptainer'
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = '--cleanenv'
        process.container = { "docker://${params.container_image}" }
    }
    dgx {
        params.execution_profile = 'dgx'
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = '--cleanenv --nv'
        env.APPTAINERENV_CUDA_VISIBLE_DEVICES = params.gpu_devices
        env.CUDA_VISIBLE_DEVICES = params.gpu_devices
        process.container = { "docker://${params.container_image}" }
        // Pin devices explicitly in the launch environment; no automatic GPU discovery/allocation.
        process.maxForks = 1
    }
    slurm {
        params.execution_profile = 'slurm'
        process.executor = 'slurm'
        process.queue = params.slurm_partition
        process.clusterOptions = "--account=${params.slurm_account}"
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = '--cleanenv'
        process.container = { "docker://${params.container_image}" }
    }
    google_batch {
        params.execution_profile = 'google_batch'
        process.executor = 'google-batch'
        process {
            withName: RUN {
                accelerator = { job.resources?.gpu_count ? [limit: job.resources.gpu_count, type: job.resources.gpu_type] : null }
            }
        }
        process.container = params.container_image
        google.project = params.google_project
        google.location = params.google_region
        google.batch.serviceAccountEmail = params.google_service_account
        google.batch.installGpuDrivers = params.google_install_gpu_drivers
        workDir = params.google_work_dir
    }
}
